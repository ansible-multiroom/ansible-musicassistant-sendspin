# {{ warning_message }}

[Unit]
Description=Audio Capture to Named Pipe
{% if (local_captures | selectattr('sourcetype', 'equalto', 'bluealsa') | list | length) > 0 %}
After=bluealsa.service systemd-tmpfiles-setup.service
Requires=bluealsa.service systemd-tmpfiles-setup.service
{% else %}
After=systemd-tmpfiles-setup.service
Requires=systemd-tmpfiles-setup.service
{% endif %}
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/audio_capture %I
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
