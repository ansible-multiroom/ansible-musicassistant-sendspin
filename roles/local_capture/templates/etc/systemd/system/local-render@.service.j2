# {{ warning_message }}

[Unit]
Description=Render music to http or local alsa sink
After=network-online.target systemd-tmpfiles-setup.service
Requires=systemd-tmpfiles-setup.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/audio_render %I
Restart=always
RestartSec=1s
KillSignal=SIGINT
KillMode=control-group

[Install]
WantedBy=multi-user.target

