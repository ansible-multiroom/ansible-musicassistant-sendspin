#!/usr/bin/bash
#
# {{ warning_message }}

instance=$1

conffile=/etc/default/capture_${instance}.conf
echo "sourcing $conffile"
. $conffile
cat $conffile
echo "sourced $conffile"

if [[ "$SINKTYPE" == http-stream ]]
then
  exec /usr/bin/ffmpeg \
    -hide_banner \
    -nostats \
    -loglevel warning \
    -fflags nobuffer \
    -thread_queue_size 512 \
    -f s16le -ar 44100 -ac 2 \
    -i "${PIPE}" \
    -c:a flac -frame_size 512 -compression_level 0 \
    -f ogg \
    -listen 1 -timeout 1 \
    "http://{{ ansible_facts["default_ipv4"]["address"] }}:${SINKID}/"
else
  exec aplay -D ${SINKID} -f cd -t raw ${PIPE}
fi
