#!/usr/bin/bash
#
# {{ warning_message }}

instance=$1

conffile=/etc/default/audiopipe_${instance}.conf
echo "sourcing $conffile"
. $conffile
cat $conffile

logger -t "alsa2http" -p local3.err "starting ffmpeg"
/usr/bin/ffmpeg \
  -nostdin \
  -hide_banner \
  -nostats \
  -loglevel warning \
  -fflags nobuffer+flush_packets \
  -flags low_delay \
  -thread_queue_size 256 \
  -f alsa -channels 2 -sample_rate 44100 -i ${A2H_SOURCE} \
  -c:a flac -frame_size 256 -compression_level 0 \
  -blocksize 1024 \
  -headers "Content-Type: audio/x-flac" \
  -f flac \
  -listen 1 \
  -timeout -1 \
  -tcp_nodelay 1 \
  http://{{ ansible_facts["default_ipv4"]["address"] }}:${A2H_HTTP_PORT}/
logger -t "alsa2http" -p local3.err "ended ffmpeg"

